# -------------------------------------------------------------------
# Kopiere diese Datei nach ".env" und trage deine Keys ein.
# Die .env ist in .gitignore - sie darf NIE in ein Repository.
# -------------------------------------------------------------------

# Aus dem Alpaca-Dashboard -> Home -> "Generate New Key" (Paper Trading)
ALPACA_API_KEY=<hier_deine_api_key_id>
ALPACA_SECRET_KEY=<hier_dein_secret_key>

# true  = Paper Trading (Spielgeld, paper-api.alpaca.markets)
# false = ECHTES GELD. Braucht zusaetzlich ALLOW_LIVE_TRADING=true.
ALPACA_PAPER=true

# Marktdaten-Feed:
#   iex         - kostenlos, real-time, nur IEX-Volumen  <- Standard
#   delayed_sip - kostenlos, alle Boersen, 15 Min verzoegert
#   sip         - alle Boersen real-time (kostenpflichtiges Abo)
ALPACA_DATA_FEED=iex

# --- Risiko-Leitplanken (greifen bei jeder Order) ---
# Maximaler Anteil des Portfolios in einer einzelnen Position
MAX_POSITION_PCT=0.10
# Harte Obergrenze in USD pro Order
MAX_ORDER_NOTIONAL=5000
# Zusaetzliche Sicherung gegen versehentliches Live-Trading
ALLOW_LIVE_TRADING=false
